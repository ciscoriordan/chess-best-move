    "%@ added here taken back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die hier hinzugefügten %1$@ wurden zurückgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han retirado los %1$@ añadidos aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han retirado los %1$@ agregados aquí."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binawi ang %@ na idinagdag dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %1$@ ajoutées ici ont été retirées."
          }
        },
        "hi": {
