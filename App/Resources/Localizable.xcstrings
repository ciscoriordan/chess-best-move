          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada %1$@. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement : %1$@. Résiliation à tout moment."
