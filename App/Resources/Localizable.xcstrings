    "%@ added here taken back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die hier hinzugefügten %1$@ wurden zurückgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han retirado los %1$@ añadidos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %1$@ ajoutées ici ont été retirées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimosse %1$@ aggiunte qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %1$@ adicionadas aqui foram removidas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada eklenen %1$@ geri alındı."
          }
        }
      }
    },
    "%@ added. %lld purchased now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hinzugefügt. Jetzt %2$lld gekaufte Analysen verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ added. %2$lld purchased now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han añadido %1$@. Ahora hay %2$lld análisis comprados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ajoutées. Il y a maintenant %2$lld analyses achetées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunte %1$@. Ora le analisi acquistate sono %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
