          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica nel codice sorgente pubblicato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alteração na fonte publicada"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayımlanan kaynak koddaki değişiklik"
          }
        }
      }
    },
    "The analysis is still running in Chess Best Move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Analyse läuft noch in Chess Best Move."
