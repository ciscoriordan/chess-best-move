          "stringUnit": {
            "state": "translated",
            "value": "İptal edene kadar yenilenen Pro aboneliği."
          }
        }
      }
    },
    "A longer search found a different move. Pro shows it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine längere Suche hat einen anderen Zug gefunden. Pro zeigt ihn dir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras una búsqueda más exhaustiva se encontró una jugada diferente. Pro la muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche plus approfondie a permis de trouver un autre coup. Pro l’affiche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’analisi più lunga ha trovato una mossa diversa. Pro la mostra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma busca mais aprofundada encontrou um lance diferente. O Pro mostra isso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha uzun aramada farklı bir hamle bulundu. Pro bu hamleyi gösterir."
          }
        }
      }
    },
