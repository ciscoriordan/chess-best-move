    "Every analysis is unlimited, at no cost. Restore purchases is here for anything you bought on another device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst alle Analysen kostenlos und ohne Begrenzung nutzen. Mit „Käufe wiederherstellen“ stellst du Käufe wieder her, die du auf einem anderen Gerät getätigt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los análisis son ilimitados y gratuitos. La función «Restaurar compras» está disponible para cualquier cosa que hayas comprado en otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque analyse est illimitée et gratuite. La fonction « Restaurer les achats » est disponible pour tout ce que vous avez acheté sur un autre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le analisi sono illimitate e gratuite. Puoi ripristinare gli acquisti effettuati su un altro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as análises são ilimitadas e gratuitas. A função “Restaurar compras” está disponível para tudo o que você comprou em outro dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm analizler sınırsız ve ücretsizdir. Başka bir aygıtta satın aldıklarınız için Satın alımları geri yükle seçeneğini kullanabilirsiniz."
          }
        }
      }
    },
    "FEN": {
