            "value": "Hebdomadaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साप्ताहिक"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Settimanale"
          }
        },
        "pt-BR": {
