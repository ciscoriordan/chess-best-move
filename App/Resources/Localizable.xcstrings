        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sont conservés, et vous pouvez les dépenser si l’abonnement Pro prend fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ restano disponibili e potrai usarle se Pro termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
