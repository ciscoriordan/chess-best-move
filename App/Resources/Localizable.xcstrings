    "A longer search still prefers this move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch nach längerer Suche ist dies der bevorzugte Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una búsqueda más exhaustiva sigue dando preferencia a esta jugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche plus approfondie privilégie toujours ce coup."
