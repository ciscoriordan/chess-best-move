        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han agregado %1$@. Ahora hay %2$lld análisis comprados."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadagdag ang %1$@. May %2$lld nang biniling pagsusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ajoutées. Il y a maintenant %2$lld analyses achetées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ जोड़े गए। अब %2$lld खरीदे हुए विश्लेषण हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunte %1$@. Ora le analisi acquistate sono %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adicionadas. Agora há %2$lld análises compradas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ eklendi. Satın alınan toplam: %2$lld."
          }
        }
