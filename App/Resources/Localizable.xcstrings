        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा बोर्ड दिखना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scacchiera deve essere interamente visibile."
          }
