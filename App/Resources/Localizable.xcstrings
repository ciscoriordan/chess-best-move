    "Longer think times find deeper moves. Re-running a board with another think time is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit mehr Bedenkzeit werden tiefere Varianten gefunden. Eine erneute Analyse derselben Stellung mit anderer Bedenkzeit ist kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar más tiempo permite al motor buscar más a fondo. Repetir el análisis del tablero con otro tiempo es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de temps permet au moteur de chercher plus en profondeur. Réanalyser l’échiquier avec une autre durée est gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tempo maggiore permette di trovare mosse più profonde. Ripetere l’analisi di una posizione con un tempo diverso è gratuito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais tempo permite ao motor pesquisar mais a fundo. Repetir a análise do tabuleiro com outro tempo é grátis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha uzun düşünme süreleri daha derin hamleler bulur. Bir tahtayı farklı düşünme süresiyle yeniden analiz etmek ücretsizdir."
          }
        }
      }
    },
