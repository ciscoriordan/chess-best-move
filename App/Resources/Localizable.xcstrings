    "Renews every %@. Cancel anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Verlängerung (%1$@). Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada %1$@. Cancela cuando quieras."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada %1$@. Cancela cuando quieras."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagre-renew kada %@. Puwedeng kanselahin anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement : %1$@. Résiliation à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर %@ अपने आप नवीनीकृत होता है। कभी भी रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni %1$@. Puoi annullare quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova a cada %1$@. Cancele quando quiser."
          }
        },
