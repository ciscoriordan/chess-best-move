    "%@ has more queens, rooks, bishops or knights than its missing pawns could have promoted to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mehr Damen, Türme, Läufer oder Springer, als durch die fehlenden Bauern entstanden sein können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %1$@ tienen más damas, torres, alfiles o caballos de los que podrían tener por la promoción de sus peones ausentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %1$@ ont plus de dames, de tours, de fous ou de cavaliers que les pions manquants n’auraient pu en produire par promotion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$@ ha più donne, torri, alfieri o cavalli di quanti potrebbero derivare dalla promozione dei pedoni mancanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As %1$@ têm mais damas, torres, bispos ou cavalos do que seria possível pela promoção dos peões ausentes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarafında, eksik piyonların terfi etmesiyle elde edilebilecek olandan daha fazla vezir, kale, fil veya at var."
          }
        }
      }
    },
