    "Free analyses back to %lld of %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlose Analysen auf %1$lld von %2$lld zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free analyses back to %1$lld of %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis gratuitos restablecidos: %1$lld de %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyses gratuites rétablies : %1$lld sur %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisi gratuite ripristinate a %1$lld su %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análises gratuitas restauradas: %1$lld de %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz analiz sayısı %2$lld üzerinden yeniden %1$lld oldu."
          }
        }
      }
    },
    "Free analyses go back to 3, the boards already paid for are forgotten, and analyses added here are taken back. Bought analyses and Pro are not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlosen Analysen werden auf 3 zurückgesetzt, bereits bezahlte Stellungen werden vergessen und hier hinzugefügte Analysen werden entfernt. Gekaufte Analysen und Pro bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis gratuitos se restablecen a 3, los tableros ya pagados se olvidan y los análisis añadidos aquí se retiran. Los análisis comprados y la versión Pro no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses gratuites remontent jusqu’à 3, les échiquiers déjà payés sont oubliés et les analyses ajoutées ici sont supprimées. Les analyses achetées et la version Pro ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le analisi gratuite tornano a 3, le posizioni già pagate vengono dimenticate e le analisi aggiunte qui vengono rimosse. Le analisi acquistate e Pro restano invariati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As análises gratuitas voltam para 3; os tabuleiros já pagos são esquecidos; e as análises adicionadas aqui são revertidas. As análises compradas e a versão Pro não são afetadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz analiz sayısı yeniden 3 olur, daha önce analiz hakkı kullanılarak açılan tahtalar unutulur ve burada eklenen analizler geri alınır. Satın alınan analizler ve Pro erişimi değişmez."
          }
        }
      }
    },
