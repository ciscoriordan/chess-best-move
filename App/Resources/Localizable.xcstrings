    "A Pro subscription, which renews until you cancel it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Pro-Abonnement, das sich verlängert, bis du es kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción Pro, que se renueva hasta que la canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Pro, qui se renouvelle jusqu’à ce que vous le résiliiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento Pro che si rinnova fino all’annullamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura Pro, que se renova até que você a cancele."
          }
        },
