    "Pro Lifetime, bought once. It does not renew and it does not expire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro dauerhaft: einmal kaufen, ohne Verlängerung und ohne Ablaufdatum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro de por vida, con un único pago. No se renueva y no caduca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro à vie, avec un achat unique. Sans renouvellement ni expiration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro a vita, con un unico acquisto. Non si rinnova e non scade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vitalício, com uma única compra. Não se renova e não expira."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ömür boyu, tek seferlik satın alınır. Yenilenmez ve süresi dolmaz."
          }
        }
      }
    },
