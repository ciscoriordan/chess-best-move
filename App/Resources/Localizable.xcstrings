    "Stopped before the think time was up. Run it again for the full think time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor Ablauf der Bedenkzeit gestoppt. Starte die Analyse erneut, um die volle Bedenkzeit zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo antes de agotar el tiempo. Repítelo para usar todo el tiempo de análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse s’est arrêtée avant la fin du temps prévu. Relancez-la pour utiliser toute la durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi si è interrotta prima del tempo previsto. Avviala di nuovo per completarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise parou antes de terminar o tempo. Execute novamente para usar todo o tempo de análise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşünme süresi dolmadan durduruldu. Sürenin tamamını kullanmak için yeniden çalıştırın."
          }
        }
      }
    },
    "Stopped when the app went to the background. Run it again for the full think time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt, als die App in den Hintergrund wechselte. Starte die Analyse erneut, um die volle Bedenkzeit zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo al pasar la app a segundo plano. Repítelo para usar todo el tiempo de análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse s’est arrêtée lorsque l’app est passée en arrière-plan. Relancez-la pour utiliser toute la durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi si è interrotta quando l’app è passata in background. Avviala di nuovo per completarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise parou quando o app foi para segundo plano. Execute novamente para usar todo o tempo de análise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama arka plana geçtiğinde durduruldu. Düşünme süresinin tamamını kullanmak için yeniden çalıştırın."
          }
        }
      }
    },
