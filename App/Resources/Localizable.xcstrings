    "Swaps the side to move and analyzes again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt die Farbe am Zug und analysiert erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el bando al que le toca mover y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change le camp dont c’est le tour et analyse à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il colore che ha il tratto e ripete l’analisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca o lado que deve jogar e analisa novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamle sırasını değiştirir ve yeniden analiz eder."
          }
        }
      }
    },
    "Swaps which side is at the bottom": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt die Farbe am unteren Brettrand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia qué lado aparece en la parte inferior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverser le côté qui se trouve en bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il colore in basso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca o lado que fica na parte inferior"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altta hangi tarafın olduğunu değiştirir"
          }
        }
      }
    },
    "Swipe up or down to change the piece. Double tap to select it for the palette.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche nach oben oder unten, um die Figur zu ändern. Tippe zweimal, um sie in der Figurenpalette auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza el dedo hacia arriba o hacia abajo para cambiar la pieza. Toca dos veces para seleccionarla en la paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser votre doigt vers le haut ou vers le bas pour changer de pièce. Appuyez deux fois pour la sélectionner dans la palette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso l’alto o il basso per cambiare pezzo. Tocca due volte per selezionarlo nella tavolozza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para cima ou para baixo para trocar a peça. Toque duas vezes para selecioná-la na paleta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşı değiştirmek için yukarı veya aşağı kaydırın. Taşı palet için seçmek üzere çift dokunun."
          }
        }
      }
    },
    "Switch side to move": {
      "localizations": {
        "de": {
          "stringUnit": {
