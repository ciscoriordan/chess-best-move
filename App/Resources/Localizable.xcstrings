    },
    "Tap to animate the move. The original position returns afterward.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um den Zug zu animieren. Danach erscheint wieder die ursprüngliche Stellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para animar la jugada. Después se restaura la posición original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour animer le coup. La position d’origine sera ensuite rétablie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per animare la mossa. La posizione originale verrà poi ripristinata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para animar a jogada. A posição original volta em seguida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamleyi canlandırmak için dokunun. Ardından ilk konum geri gelir."
          }
        }
      }
    },
