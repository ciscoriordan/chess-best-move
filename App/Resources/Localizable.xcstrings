          }
        }
      }
    },
    "In the Shortcuts app, create a shortcut named “Analyze my chess screenshot”. Add “Take Screenshot” as its first action.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle in der App „Kurzbefehle“ einen Kurzbefehl mit dem Namen „Analysiere meinen Schach-Screenshot“. Füge als erste Aktion „Bildschirmfoto aufnehmen“ hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la app Atajos, crea un atajo llamado «Analiza mi captura de ajedrez». Añade «Hacer captura de pantalla» como primera acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’application Raccourcis, créez un raccourci intitulé « Analyse ma capture d’échecs ». Ajoutez « Prendre une capture d’écran » comme première action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell’app Comandi Rapidi, crea un comando rapido chiamato “Analizza il mio screenshot di scacchi”. Aggiungi “Scatta screenshot” come prima azione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No aplicativo Atalhos, crie um atalho chamado “Analise minha captura de xadrez”. Adicione “Fazer captura de tela” como sua primeira ação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler uygulamasında “Satranç ekran görüntümü analiz et” adlı bir kestirme oluşturun. İlk eylem olarak “Ekran Görüntüsü Al” eylemini ekleyin."
          }
        }
      }
    },
