            "state": "translated",
            "value": "El reconocimiento no está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance n’est pas disponible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconoscimento non disponibile"
          }
        },
        "pt-BR": {
          "stringUnit": {
