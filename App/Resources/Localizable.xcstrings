    "Thinking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird analysiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizando."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizando."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
