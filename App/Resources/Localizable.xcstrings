    "Waiting for purchase approval. The analysis starts when it is approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf die Kaufgenehmigung. Die Analyse startet, sobald der Kauf genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la espera de la aprobación de la compra. El análisis comienza cuando se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de validation de l’achat. L’analyse démarre dès que celui-ci est validé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa di approvazione dell’acquisto. L’analisi inizierà appena sarà approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação da compra. A análise começa assim que for aprovada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma onayı bekleniyor. Onay verildiğinde analiz başlar."
          }
        }
      }
    },
    "Weekly": {
      "localizations": {
