    "Training Data and License": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsdaten und Lizenz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de entrenamiento y licencia"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de entrenamiento y licencia"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Training Data at Lisensya"
          }
        },
        "fr": {
