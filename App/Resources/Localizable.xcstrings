        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay algo en tu captura de pantalla que tapa las casillas marcadas, como un banner, una tarjeta o un menú."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay algo en tu captura de pantalla que tapa las casillas marcadas, como un banner, una tarjeta o un menú."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May nakatakip sa mga minarkahang parisukat sa screenshot, gaya ng banner, card, o menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément de votre capture d’écran recouvre les cases marquées, par exemple une bannière, une carte ou un menu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनशॉट में बैनर, कार्ड या मेनू जैसी किसी चीज़ ने चिह्नित खाने ढक दिए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nello screenshot, qualcosa copre le case evidenziate, per esempio un banner, un riquadro o un menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo na sua captura de tela cobre as casas marcadas, como um banner, um cartão ou um menu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntünüzde işaretli kareleri kapatan bir başlık, kart veya menü var."
          }
        }
      }
    },
