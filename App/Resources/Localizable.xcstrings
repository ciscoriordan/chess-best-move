    "Most chess sites do not allow engine help in games you are playing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Schachseiten erlauben keine Engine-Hilfe während laufender Partien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los sitios web de ajedrez no permiten el uso de motores de ayuda en las partidas que estás jugando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des sites d’échecs n’autorisent pas l’aide d’un moteur lors des parties que vous jouez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maggior parte dei siti di scacchi non consente l’aiuto di un motore durante una partita in corso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A maioria dos sites de xadrez não permite o uso de ajuda de motor nas partidas que você está jogando."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoğu satranç sitesi, oynadığınız oyunlarda motor yardımı kullanmanıza izin vermez."
          }
        }
      }
    },
