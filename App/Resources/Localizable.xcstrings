    "Analyzes %@ to move instead. Re-running is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiert stattdessen mit %1$@ am Zug. Die erneute Analyse ist kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la posición con turno de las %1$@. Repetir el análisis es gratis."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la posición con turno de las %1$@. Repetir el análisis es gratis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Susuriin na parang tira ng %@. Libreng ulitin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse la position avec le trait aux %1$@. Relancer l’analyse est gratuit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब %@ की चाल मानकर विश्लेषण होगा। दोबारा चलाना मुफ़्त है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
