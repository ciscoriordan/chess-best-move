      }
    },
    "The chess engine stopped unexpectedly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schachengine wurde unerwartet beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez se detuvo de forma inesperada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez se detuvo de forma inesperada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Biglang huminto ang chess engine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’échecs s’est arrêté de manière inattendue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शतरंज इंजन अचानक रुक गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
