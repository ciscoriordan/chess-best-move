    "New chess screenshot found. Tap Analyze to continue. Individual analyses are used only after you tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Schach-Screenshot gefunden. Tippe auf „Analysieren“, um fortzufahren. Einzelne Analysen werden erst nach dem Tippen verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha encontrado una nueva captura de ajedrez. Pulsa «Analizar» para continuar. Los análisis individuales solo se utilizan después de que pulses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle capture d’écran d’échecs détectée. Appuyez sur « Analyser » pour continuer. Les analyses individuelles ne sont utilisées qu’après avoir appuyé sur ce bouton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovato un nuovo screenshot di scacchi. Tocca Analizza per continuare. Le analisi singole vengono consumate solo dopo il tocco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova captura de xadrez encontrada. Toque em “Analisar” para continuar. As análises individuais são utilizadas somente após você tocar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni satranç ekran görüntüsü bulundu. Devam etmek için Analiz et’e dokunun. Tekil analiz hakları yalnızca dokunduktan sonra kullanılır."
          }
        }
      }
    },
    "New chess screenshots are recognized automatically. Tap Analyze if asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Schach-Screenshots werden automatisch erkannt. Tippe auf „Analysieren“, wenn du dazu aufgefordert wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas capturas de pantalla de ajedrez se reconocen automáticamente. Pulsa «Analizar» si se te solicita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles captures d’écran d’échecs sont reconnues automatiquement. Appuyez sur « Analyser » si vous y êtes invité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi screenshot di scacchi vengono riconosciuti automaticamente. Tocca Analizza se richiesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas capturas de tela de xadrez são reconhecidas automaticamente. Toque em “Analisar” se solicitado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni satranç ekran görüntüleri otomatik tanınır. İstenirse Analiz et’e dokunun."
          }
        }
      }
    },
