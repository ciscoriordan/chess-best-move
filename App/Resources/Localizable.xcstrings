        }
      }
    },
    "Take a chess screenshot, then open this app. Analysis starts automatically with unlimited access; otherwise, tap Analyze when asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Schach-Screenshot auf und öffne diese App. Mit unbegrenztem Zugang startet die Analyse automatisch. Andernfalls tippe auf „Analysieren“, wenn du dazu aufgefordert wirst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla del tablero de ajedrez y, a continuación, abre esta aplicación. El análisis se inicia automáticamente con acceso ilimitado; de lo contrario, pulsa «Analizar» cuando se te solicite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de l’échiquier, puis ouvrez cette application. L’analyse démarre automatiquement avec un accès illimité ; sinon, appuyez sur « Analyser » lorsque vous y êtes invité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot di scacchi, poi apri quest’app. Con l’accesso illimitato, l’analisi parte automaticamente; altrimenti, tocca Analizza quando richiesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma captura de tela do xadrez e, em seguida, abra este aplicativo. A análise começa automaticamente com acesso ilimitado; caso contrário, toque em “Analisar” quando solicitado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satranç ekran görüntüsü alın, ardından bu uygulamayı açın. Sınırsız erişiminiz varsa analiz otomatik başlar; yoksa istendiğinde Analiz et’e dokunun."
          }
        }
      }
    },
    "Take a screenshot of the position.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot der Stellung auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla de la posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de la position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot della posizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela da posição."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun ekran görüntüsünü alın."
          }
        }
      }
    },
    "Take a screenshot of the position: press the side button and the Home button together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot der Stellung auf: Drücke gleichzeitig die Seitentaste und die Home-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla de la posición: pulsa a la vez el botón lateral y el botón de Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de la position : appuyez simultanément sur le bouton latéral et le bouton Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot della posizione: premi insieme il tasto laterale e il tasto Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela da posição: pressione o botão lateral e o botão de Início ao mesmo tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun ekran görüntüsünü almak için yan düğmeye ve Ana Ekran düğmesine aynı anda basın."
          }
        }
      }
    },
    "Take a screenshot of the position: press the side button and volume up together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot der Stellung auf: Drücke gleichzeitig die Seitentaste und die Lauter-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla de la posición: pulsa a la vez el botón lateral y el de subir volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de la position : appuyez simultanément sur le bouton latéral et sur le bouton d’augmentation du volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot della posizione: premi insieme il tasto laterale e il tasto per alzare il volume."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela da posição: pressione o botão lateral e o botão de aumentar o volume ao mesmo tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun ekran görüntüsünü almak için yan düğmeye ve sesi aç düğmesine aynı anda basın."
          }
        }
      }
    },
    "Take a screenshot of the position: press the top button and a volume button together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot der Stellung auf: Drücke gleichzeitig die obere Taste und eine Lautstärketaste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla de la posición: pulsa a la vez el botón superior y uno de los botones de volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de la position : appuyez simultanément sur le bouton du haut et sur un bouton de volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot della posizione: premi insieme il tasto superiore e un tasto del volume."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela da posição: pressione o botão superior e um botão de volume ao mesmo tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun ekran görüntüsünü almak için üst düğmeye ve ses düğmelerinden birine aynı anda basın."
          }
        }
      }
    },
    "Take a screenshot of the position: press the top button and the Home button together.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot der Stellung auf: Drücke gleichzeitig die obere Taste und die Home-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla de la posición: pulsa a la vez el botón superior y el botón de Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran de la position : appuyez simultanément sur le bouton du haut et le bouton Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot della posizione: premi insieme il tasto superiore e il tasto Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela da posição: pressione o botão superior e o botão de Início ao mesmo tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumun ekran görüntüsünü almak için üst düğmeye ve Ana Ekran düğmesine aynı anda basın."
          }
        }
      }
    },
    "Take a screenshot, save it to Photos, and analyze it with one shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshot aufnehmen, in Fotos speichern und analysieren – mit einem Kurzbefehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla, guárdala en «Fotos» y analízala con un solo atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une capture d’écran, enregistrez-la dans « Photos » et analysez-la à l’aide d’un seul raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot, salvalo in Foto e analizzalo con un solo comando rapido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela, salve-a no aplicativo Fotos e analise-a com um único atalho."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek kestirmeyle ekran görüntüsü alın, Fotoğraflar’a kaydedin ve analiz edin."
          }
        }
      }
    },
    "Take a screenshot, save it, and find the best move from Control Center, the Action button, or Back Tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm einen Screenshot auf, speichere ihn und finde den besten Zug: über das Kontrollzentrum, die Aktionstaste oder durch Tippen auf die Rückseite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una captura de pantalla, guárdala y busca la mejor jugada desde el Centro de control, el botón de acción o Tocar atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une capture d’écran, enregistrez-la, puis trouvez le meilleur coup à partir du Centre de contrôle, du bouton Action ou de la fonction « Toucher le dos de l’appareil »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta uno screenshot, salvalo e trova la mossa migliore da Centro di Controllo, con il pulsante Azione o con Tocco posteriore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma captura de tela, salve-a e encontre o melhor lance na Central de Controle, no botão de ação ou com o Tocar Atrás."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Denetim Merkezi, Eylem düğmesi veya Arkaya Dokunma ile ekran görüntüsü alın, kaydedin ve en iyi hamleyi bulun."
          }
        }
      }
    },
