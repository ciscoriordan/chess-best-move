    "Stockfish's neural network (nn-1a298aa575a0.nnue) is trained on data provided by the Leela Chess Zero project, which is made available under the Open Database License (ODbL).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neuronale Netz von Stockfish (nn-1a298aa575a0.nnue) wurde mit Daten des Projekts Leela Chess Zero trainiert, die unter der Open Database License (ODbL) bereitgestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red neuronal de Stockfish (nn-1a298aa575a0.nnue) se ha entrenado con datos proporcionados por el proyecto Leela Chess Zero, que se pone a disposición bajo la Licencia de Base de Datos Abierta (ODbL)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau neuronal de Stockfish (nn-1a298aa575a0.nnue) est entraîné à partir de données fournies par le projet Leela Chess Zero, mises à disposition sous licence Open Database License (ODbL)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete neurale di Stockfish (nn-1a298aa575a0.nnue) è addestrata su dati forniti dal progetto Leela Chess Zero, disponibili con licenza Open Database License (ODbL)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede neural do Stockfish (nn-1a298aa575a0.nnue) é treinada com dados fornecidos pelo projeto Leela Chess Zero, que está disponível sob a Licença de Banco de Dados Aberto (ODbL)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockfish’in sinir ağı (nn-1a298aa575a0.nnue), Leela Chess Zero projesi tarafından sağlanan ve Açık Veritabanı Lisansı (ODbL) kapsamında sunulan verilerle eğitilmiştir."
          }
        }
      }
    },
