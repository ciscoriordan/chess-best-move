    "Finds the best move in a screenshot of a chess position. Pass a screenshot, or choose one from Photos when Chess Best Move opens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet den besten Zug in einem Screenshot einer Schachstellung. Übergib einen Screenshot oder wähle einen aus Fotos, wenn Chess Best Move geöffnet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca la mejor jugada en una captura de pantalla de una posición de ajedrez. Pasa una captura de pantalla o elige una de «Fotos» cuando se abra «Chess Best Move»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche le meilleur coup dans une capture d’écran d’une position d’échecs. Transmettez une capture d’écran ou choisissez-en une dans « Photos » lorsque l’application « Chess Best Move » s’ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova la mossa migliore nello screenshot di una posizione scacchistica. Passa uno screenshot oppure scegline uno da Foto quando si apre Chess Best Move."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra o melhor lance em uma captura de tela de uma posição de xadrez. Passe uma captura de tela ou escolha uma no aplicativo Fotos quando o Chess Best Move for aberto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satranç konumunun ekran görüntüsünde en iyi hamleyi bulur. Bir ekran görüntüsü iletin veya Chess Best Move açıldığında Fotoğraflar’dan bir görüntü seçin."
          }
        }
      }
    },
