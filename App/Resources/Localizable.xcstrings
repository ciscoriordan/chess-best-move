          }
        }
      }
    },
    "Their likely move: %@. Best reply: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voraussichtlicher gegnerischer Zug: %1$@. Beste Antwort: %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Their likely move: %1$@. Best reply: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugada probable del rival: %1$@. Mejor respuesta: %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup probable de l’adversaire : %1$@. Meilleure réponse : %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mossa probabile dell’altro giocatore: %1$@. Migliore risposta: %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance provável do adversário: %1$@. Melhor resposta: %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen hamle: %1$@. En iyi yanıt: %2$@."
          }
        }
      }
    },
    "Their move": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegnerischer Zug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su jugada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur coup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mossa dell’altro giocatore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A jogada deles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer oyuncunun hamlesi"
          }
        }
      }
    },
    "Their move is a guess from the engine's own line. This answer holds only if they play it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gegnerische Zug ist eine Vermutung aus der berechneten Variante. Diese Antwort gilt nur, wenn er tatsächlich gespielt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su jugada es una suposición basada en la propia línea del motor. Esta respuesta solo es válida si la juegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur coup est une supposition issue de la ligne de jeu propre au moteur. Cette réponse n’est valable que s’ils jouent ce coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mossa dell’altro giocatore è un’ipotesi tratta dalla variante del motore. Questa risposta vale solo se viene giocata quella mossa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lance deles é uma suposição baseada na própria linha do mecanismo. Essa resposta só se aplica se eles realmente jogarem esse lance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hamle, motorun kendi varyantından yaptığı bir tahmindir. Bu yanıt yalnızca o hamle oynanırsa geçerlidir."
          }
        }
      }
    },
    "These controls are in TestFlight builds and never in an App Store build. They grant analyses, never Pro: Pro comes from a purchase, which costs nothing in the TestFlight sandbox.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Steuerelemente sind in TestFlight-Versionen vorhanden, niemals in einer App-Store-Version. Sie gewähren Analysen, aber kein Pro. Pro wird durch einen Kauf freigeschaltet, der in der TestFlight-Sandbox nichts kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos controles se encuentran en las versiones de TestFlight y nunca en una versión del App Store. Otorgan acceso a las funciones de análisis, pero nunca a las de la versión Pro: la versión Pro se obtiene mediante una compra, que no tiene ningún coste en el entorno de pruebas de TestFlight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces commandes se trouvent dans les versions TestFlight et jamais dans une version de l’App Store. Elles donnent accès à des analyses, jamais à la version Pro : la version Pro est issue d’un achat, qui ne coûte rien dans l’environnement TestFlight."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi controlli sono presenti nelle versioni TestFlight, mai in quelle dell’App Store. Aggiungono analisi, non Pro: Pro si ottiene con un acquisto, gratuito nell’ambiente sandbox di TestFlight."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses controles estão nas compilações do TestFlight e nunca em uma compilação da App Store. Eles concedem análises, nunca a versão Pro: a versão Pro é obtida por meio de uma compra, que não custa nada no ambiente de teste do TestFlight."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denetimler TestFlight derlemelerinde bulunur, App Store derlemelerinde bulunmaz. Analiz hakkı verirler, Pro vermezler. Pro, TestFlight test ortamında ücretsiz olan bir satın alma işlemiyle açılır."
          }
        }
      }
    },
