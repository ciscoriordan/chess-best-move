          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse est toujours en cours dans Chess Best Move."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi è ancora in corso in Chess Best Move."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise ainda está em andamento no Chess Best Move."
          }
        },
        "tr": {
