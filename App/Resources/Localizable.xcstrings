    "You can still set up the position by hand and analyze it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Stellung weiterhin von Hand aufbauen und analysieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes configurar la posición manualmente y analizarla."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes configurar la posición manualmente y analizarla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mo pa ring ayusin nang mano-mano ang posisyon at suriin ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours configurer la position manuellement et l’analyser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अब भी स्थिति ख़ुद बनाकर विश्लेषण कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi comunque impostare la posizione a mano e analizzarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode configurar a posição manualmente e analisá-la."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumu yine de elle oluşturup analiz edebilirsiniz."
          }
        }
      }
    },
    "You're offline. Connect to the internet and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Conéctate a Internet e inténtalo de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Conéctate a Internet e inténtalo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
