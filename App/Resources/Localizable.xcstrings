        }
      }
    },
    "Open Chess Best Move to see the best move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Chess Best Move, um den besten Zug zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Chess Best Move para ver la mejor jugada."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Chess Best Move para ver la mejor jugada."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Chess Best Move para makita ang pinakamahusay na tira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Chess Best Move pour voir le meilleur coup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे अच्छी चाल देखने के लिए Chess Best Move खोलें।"
          }
        },
        "it": {
          "stringUnit": {
