    "Your screenshot shows %lld boards. If this is not the one you want, crop the screenshot to that board and import it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Screenshot zeigt %1$lld Bretter. Ist dies nicht das gewünschte Brett, schneide den Screenshot auf das richtige Brett zu und importiere ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La captura muestra %1$lld tableros. Si este no es el que quieres, recorta la captura para dejar solo el tablero deseado e impórtala de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture montre %1$lld échiquiers. Si ce n’est pas celui que vous souhaitez, recadrez la capture sur le bon échiquier et importez-la à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo screenshot mostra %1$lld scacchiere. Se questa non è quella che vuoi, ritaglia lo screenshot intorno alla scacchiera desiderata e importalo di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A captura mostra %1$lld tabuleiros. Se este não for o desejado, recorte a captura para deixar apenas o tabuleiro desejado e importe-a novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntünüzde %1$lld tahta var. İstediğiniz tahta bu değilse ekran görüntüsünü o tahtayı içerecek şekilde kırpıp yeniden içe aktarın."
          }
        }
      }
    },
