    },
    "The chess engine's neural network is missing from the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neuronale Netz der Schachengine fehlt in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red neuronal del motor de ajedrez no está incluida en la aplicación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La red neuronal del motor de ajedrez no está incluida en la aplicación."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala sa app ang neural network ng chess engine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau neuronal du moteur d’échecs est absent de l’application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में शतरंज इंजन का न्यूरल नेटवर्क नहीं है।"
