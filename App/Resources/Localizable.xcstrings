    "Analyze any position from a screenshot: a game you are reviewing, a puzzle or a study.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere eine Stellung aus einem Screenshot: eine Partie zum Nachspielen, eine Schachaufgabe oder eine Studie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza cualquier posición a partir de una captura de pantalla: una partida que estés revisando, un rompecabezas o un estudio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez n’importe quelle position à partir d’une capture d’écran : une partie que vous revoyez, un casse-tête ou une étude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza una posizione da uno screenshot: una partita che stai rivedendo, un problema o uno studio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise qualquer posição a partir de uma captura de tela: uma partida que você está revisando, um quebra-cabeça ou um estudo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İncelediğiniz bir oyun, bir bulmaca veya bir etüt: ekran görüntüsünden herhangi bir konumu analiz edin."
          }
        }
      }
    },
    "Analyze every new screenshot and position, with no limit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere neue Screenshots und Stellungen ohne Begrenzung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza cada nueva captura de pantalla y posición, sin límite alguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez chaque nouvelle capture d’écran et chaque nouvelle position, sans aucune limite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza nuovi screenshot e posizioni senza limiti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise cada nova captura de tela e posição, sem limite"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yeni ekran görüntüsünü ve konumu sınırsız analiz edin"
          }
        }
      }
