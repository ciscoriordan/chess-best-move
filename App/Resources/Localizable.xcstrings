    "A longer search that keeps running after the answer, up to 2 minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche läuft nach dem Ergebnis weiter, bis zu 2 Minuten lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una búsqueda más larga que sigue ejecutándose tras la respuesta, hasta 2 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche plus longue qui se poursuit après la réponse, jusqu’à 2 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analisi prosegue dopo la risposta, fino a 2 minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pesquisa mais longa que continua em execução após a resposta, por até 2 minutos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt geldikten sonra devam eden, en fazla 2 dakikalık daha uzun bir arama."
          }
