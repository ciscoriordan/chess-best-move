    " Other marked squares were hard to read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Weitere markierte Felder waren schwer zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Otras casillas marcadas resultaban difíciles de leer."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": " Otras casillas marcadas resultaban difíciles de leer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": " Mahirap basahin ang iba pang minarkahang parisukat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " D'autres cases marquées étaient difficiles à lire."
          }
