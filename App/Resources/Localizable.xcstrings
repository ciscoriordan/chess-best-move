          "stringUnit": {
            "state": "translated",
            "value": "Una fila que un usuario gratuito puede leer pero no modificar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makikita ng libreng user ang row na ito pero hindi ito mae-edit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne qu’un utilisateur gratuit peut lire mais pas modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त इस्तेमाल करने वाले यह पंक्ति देख सकते हैं, लेकिन बदल नहीं सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga che un utente gratuito può leggere ma non modificare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha que um usuário gratuito pode ler, mas não alterar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz kullanıcının okuyabildiği ancak değiştiremediği bir satır."
          }
        }
      }
    },
    "A screenshot of a chess position. Leave empty to choose from Photos.": {
      "localizations": {
        "de": {
