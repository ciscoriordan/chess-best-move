        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está desactivado. Utiliza «Fotos» o «Pegar» en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès aux photos est désactivé. Utilisez plutôt « Photos » ou « Coller »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alle foto è disattivato. Usa Foto o Incolla."
          }
