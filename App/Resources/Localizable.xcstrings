    "An analysis is spent on a position you have not analyzed before. Re-running the same board, at any think time, is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Analyse wird für eine Stellung verbraucht, die du noch nicht analysiert hast. Dieselbe Stellung erneut zu analysieren ist kostenlos, unabhängig von der Bedenkzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descuenta un análisis al analizar una posición nueva. Repetir el análisis del mismo tablero es gratis, sea cual sea el tiempo de análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse est décomptée pour une position que vous n’avez jamais analysée. Réanalyser le même échiquier est gratuit, quelle que soit la durée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’analisi viene consumata solo per una posizione mai analizzata prima. Ripetere l’analisi della stessa posizione, con qualsiasi tempo di analisi, è gratuito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma análise é descontada ao analisar uma posição nova. Repetir a análise do mesmo tabuleiro é grátis, com qualquer tempo de análise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce analiz etmediğiniz bir konum için bir analiz hakkı kullanılır. Aynı tahtayı herhangi bir düşünme süresinde yeniden analiz etmek ücretsizdir."
          }
        }
      }
    },
