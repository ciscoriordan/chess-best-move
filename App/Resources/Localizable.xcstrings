    "Completed analyses appear here. Reopen a saved result without using another analysis.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Analysen erscheinen hier. Öffne ein gespeichertes Ergebnis, ohne eine weitere Analyse zu verbrauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis completados aparecen aquí. Abre un resultado guardado sin gastar otro análisis."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis completados aparecen aquí. Abre un resultado guardado sin gastar otro análisis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito lalabas ang mga natapos na pagsusuri. Buksan ang naka-save na resulta nang hindi gumagamit ng panibagong pagsusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses terminées apparaissent ici. Rouvrez un résultat enregistré sans décompter une autre analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे हुए विश्लेषण यहाँ दिखते हैं। सहेजा हुआ नतीजा खोलने पर नया विश्लेषण खर्च नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le analisi completate appaiono qui. Riapri un risultato salvato senza utilizzare un’altra analisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As análises concluídas aparecem aqui. Abra um resultado salvo sem usar outra análise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan analizler burada görünür. Kaydedilmiş bir sonucu başka bir analiz hakkı kullanmadan yeniden açın."
          }
        }
      }
    },
