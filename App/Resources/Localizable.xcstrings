    " Other marked squares were hard to read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Weitere markierte Felder waren schwer zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Otras casillas marcadas resultaban difíciles de leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " D'autres cases marquées étaient difficiles à lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Altre case evidenziate erano difficili da leggere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Outras casas marcadas estavam difíceis de ler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Diğer işaretli kareleri okumak zordu."
          }
        }
      }
    },
    " Something in your screenshot covers the other marked squares.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Auf deinem Screenshot sind die übrigen markierten Felder verdeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Hay algo en tu captura de pantalla que tapa las otras casillas marcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Un élément de votre capture d’écran masque les autres cases marquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Qualcosa nello screenshot copre le altre case evidenziate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Algo na sua captura de tela está cobrindo as outras casas marcadas."
