    "Analyzes %@ to move instead. Re-running is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiert stattdessen mit %1$@ am Zug. Die erneute Analyse ist kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la posición con turno de las %1$@. Repetir el análisis es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse la position avec le trait aux %1$@. Relancer l’analyse est gratuit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripete l’analisi con il tratto al %1$@. La nuova analisi è gratuita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa a posição com a vez das %1$@. Repetir a análise é grátis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine hamle sırası %1$@ tarafındayken analiz eder. Yeniden analiz ücretsizdir."
          }
        }
      }
    },
    "Analyzes again without it. Re-running is free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiert erneut ohne diese Angabe. Die erneute Analyse ist kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a analizarlo sin ello. Volver a ejecutarlo es gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez une nouvelle analyse sans cela. La réexécution est gratuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripete l’analisi senza di esso. La nuova analisi è gratuita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise novamente sem ele. A reexecução é gratuita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seçenek olmadan yeniden analiz eder. Yeniden analiz ücretsizdir."
          }
        }
      }
    },
    "Apple doesn't cancel it for you. Cancel it in your subscriptions to stop the renewals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple kündigt es nicht für dich. Kündige es unter deinen Abonnements, um weitere Verlängerungen zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no lo cancela por ti. Cancélalo en tus suscripciones para detener las renovaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ne le résilie pas à votre place. Résiliez-le dans vos abonnements pour mettre fin aux renouvellements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non lo annulla automaticamente. Annullalo nell’elenco dei tuoi abbonamenti per interrompere i rinnovi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não cancela isso para você. Cancele em suas assinaturas para interromper as renovações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bunu sizin yerinize iptal etmez. Yenilenmesini durdurmak için aboneliklerinizden iptal edin."
          }
        }
      }
    },
    "Apple's subscription settings didn't open. Manage your subscription in the Settings app, under your Apple Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Abonnementverwaltung konnte nicht geöffnet werden. Verwalte dein Abonnement in der App „Einstellungen“ unter deinem Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han abierto los ajustes de suscripción de Apple. Gestiona tu suscripción en la app «Ajustes», en tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages d’abonnement d’Apple ne s’ouvrent pas. Gérez votre abonnement dans l’application Réglages, sous votre compte Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire le impostazioni degli abbonamenti Apple. Gestisci l’abbonamento nell’app Impostazioni, sotto il tuo Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de assinatura da Apple não abriram. Gerencie sua assinatura no app “Ajustes”, na seção da sua Conta Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ın abonelik ayarları açılamadı. Aboneliğinizi Ayarlar uygulamasında Apple Hesabınızın altından yönetin."
          }
        }
      }
    },
    "Arms it: then every square you tap gets it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt die Figur aus: Sie wird auf jedes angetippte Feld gesetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona esta pieza para colocarla en cada casilla que toques"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne cette pièce pour la placer sur chaque case que vous touchez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il pezzo: verrà inserito in ogni casa che tocchi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona esta peça para colocá-la em cada casa que você tocar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşı seçer; ardından dokunduğunuz her kareye bu taş yerleştirilir"
          }
        }
      }
    },
    "Assumes castling is still allowed.": {
      "localizations": {
        "de": {
          "stringUnit": {
