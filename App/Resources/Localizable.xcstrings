    "A Pro subscription, which renews until you cancel it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Pro-Abonnement, das sich verlängert, bis du es kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción Pro, que se renueva hasta que la canceles."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción Pro, que se renueva hasta que la canceles."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro subscription na nagre-renew hanggang kanselahin mo ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Pro, qui se renouvelle jusqu’à ce que vous le résiliiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro सदस्यता, जो रद्द करने तक अपने आप नवीनीकृत होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento Pro che si rinnova fino all’annullamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura Pro, que se renova até que você a cancele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edene kadar yenilenen Pro aboneliği."
          }
        }
      }
    },
    "A longer search found a different move. Pro shows it.": {
      "extractionState": "stale",
