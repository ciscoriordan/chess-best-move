    "Check the pieces, then analyze.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Figuren und starte dann die Analyse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba las piezas y, a continuación, analiza."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las piezas y, a continuación, analiza."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang mga piyesa bago magpatakbo ng pagsusuri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les pièces, puis analysez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोहरों को जाँचें, फिर विश्लेषण करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i pezzi, poi avvia l’analisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as peças e, em seguida, analise."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşları kontrol edin, ardından analiz edin."
          }
        }
      }
    },
    "Check the pieces, then tap Analyze when you’re ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Figuren und tippe auf Analysieren, wenn du bereit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba las piezas y toca Analizar cuando estés listo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las piezas y toca Analizar cuando estés listo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang mga piyesa, tapos i-tap ang Suriin kapag handa ka na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les pièces, puis touchez Analyser quand vous êtes prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोहरों को जाँचें। तैयार होने पर “विश्लेषण करें” पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i pezzi, poi tocca Analizza quando sei pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira as peças e toque em Analisar quando estiver pronto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşları kontrol edin, hazır olduğunuzda Analiz Et’e dokunun."
          }
        }
      }
    },
