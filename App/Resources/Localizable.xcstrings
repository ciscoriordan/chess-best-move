    "On an iPad with a Home button, press the top button and the Home button at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem iPad mit Home-Taste drückst du gleichzeitig die obere Taste und die Home-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPad con botón de Inicio, pulsa el botón superior y el botón de Inicio al mismo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPad doté d’un bouton Accueil, appuyez simultanément sur le bouton du haut et sur le bouton Accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un iPad con tasto Home, premi insieme il tasto superiore e il tasto Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um iPad com botão de Início, pressione o botão superior e o botão de Início ao mesmo tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran düğmesi olan bir iPad’de üst düğmeye ve Ana Ekran düğmesine aynı anda basın."
          }
        }
      }
    },
    "On an iPhone with a Home button, press the side button and the Home button at the same time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem iPhone mit Home-Taste drückst du gleichzeitig die Seitentaste und die Home-Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone con botón de Inicio, pulsa el botón lateral y el botón de Inicio al mismo tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un iPhone doté d’un bouton principal, appuyez simultanément sur le bouton latéral et le bouton principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un iPhone con tasto Home, premi insieme il tasto laterale e il tasto Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um iPhone com botão de Início, pressione o botão lateral e o botão de Início ao mesmo tempo."
