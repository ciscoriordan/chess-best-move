    "Limited access can't see new screenshots. Pick it yourself, or use Photos or Paste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei eingeschränktem Zugriff sind neue Screenshots nicht sichtbar. Wähle das Bild selbst aus oder nutze Fotos oder Einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso limitado no permite ver nuevas capturas de pantalla. Elígelas tú mismo o utiliza «Fotos» o «Pegar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès limité ne permet pas de voir les nouvelles captures. Choisissez-en une vous-même, ou utilisez Photos ou Coller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso limitato non permette di vedere i nuovi screenshot. Selezionalo tu, oppure usa Foto o Incolla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso limitado não permite visualizar novas capturas de tela. Escolha você mesmo ou use o aplicativo Fotos ou a função Colar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlı erişimle yeni ekran görüntüleri görülemez. Kendiniz seçin ya da Fotoğraflar veya Yapıştır seçeneğini kullanın."
