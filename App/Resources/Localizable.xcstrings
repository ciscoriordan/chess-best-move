          "stringUnit": {
            "state": "new",
            "value": "%1$@ is in check but it's %2$@'s move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las %1$@ están en jaque, pero juegan las %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %1$@ sont en échec, mais le trait est aux %2$@."
          }
