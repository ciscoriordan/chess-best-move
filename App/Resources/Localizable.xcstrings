    "About %@ a week. The change starts at your next renewal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %1$@ pro Woche. Die Änderung gilt ab der nächsten Verlängerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %1$@ a la semana. El cambio se aplica en la próxima renovación."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos %1$@ a la semana. El cambio se aplica en la próxima renovación."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga %@ kada linggo. Magsisimula ang pagbabago sa susunod na renewal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %1$@ par semaine. Le changement prend effet au prochain renouvellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग %@ प्रति हफ़्ता। बदलाव अगले नवीनीकरण से लागू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %1$@ a settimana. Il cambio avviene al prossimo rinnovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %1$@ por semana. A mudança começa na próxima renovação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %1$@. Değişiklik bir sonraki yenilemede geçerli olur."
