          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz iptal edildi."
          }
        }
      }
    },
    "The app reads the board and finds the best move.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erkennt das Brett und findet den besten Zug."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación analiza el tablero y encuentra la mejor jugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application analyse l’échiquier et trouve le meilleur coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app legge la scacchiera e trova la mossa migliore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo analisa o tabuleiro e encontra o melhor lance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama tahtayı okur ve en iyi hamleyi bulur."
          }
        }
      }
    },
    "The board is small in your screenshot, about %lld pixels a square, which makes the pieces hard to read. A screenshot with the board larger reads better.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Brett ist auf deinem Screenshot klein, etwa %1$lld Pixel pro Feld. Dadurch sind die Figuren schwer zu erkennen. Ein Screenshot mit einem größeren Brett lässt sich besser lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero es pequeño en la captura, con unos %1$lld píxeles por casilla, lo que dificulta reconocer las piezas. Usa una captura con el tablero más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échiquier est petit sur la capture, avec environ %1$lld pixels par case, ce qui rend les pièces difficiles à reconnaître. Utilisez une capture où l’échiquier est plus grand."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scacchiera nello screenshot è piccola, con circa %1$lld pixel per casa, e i pezzi sono difficili da leggere. Uno screenshot con una scacchiera più grande darà risultati migliori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tabuleiro está pequeno na captura, com cerca de %1$lld pixels por casa, o que dificulta reconhecer as peças. Use uma captura com o tabuleiro maior."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntünüzde tahta küçük; kare başına yaklaşık %1$lld piksel düşüyor. Bu, taşları okumayı zorlaştırıyor. Tahtanın daha büyük olduğu bir ekran görüntüsü daha iyi okunur."
          }
        }
      }
    },
    "The chess engine can't analyze this position. Use Edit to check the pieces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schachengine kann diese Stellung nicht analysieren. Prüfe die Figuren mit „Bearbeiten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez no puede analizar esta posición. Utiliza «Editar» para comprobar las piezas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’échecs ne peut pas analyser cette position. Utilisez « Modifier » pour vérifier les pièces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore scacchistico non può analizzare questa posizione. Tocca Modifica per controllare i pezzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de xadrez não consegue analisar esta posição. Use “Editar” para verificar as peças."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç motoru bu konumu analiz edemiyor. Taşları kontrol etmek için Düzenle seçeneğini kullanın."
          }
        }
      }
    },
    "The chess engine could not start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schachengine konnte nicht gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez no se ha podido iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’échecs n’a pas pu démarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore scacchistico non ha potuto avviarsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de xadrez não conseguiu iniciar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç motoru başlatılamadı."
          }
        }
      }
    },
    "The chess engine did not start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schachengine wurde nicht gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez no se ha iniciado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’échecs ne s’est pas lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore scacchistico non si è avviato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de xadrez não iniciou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç motoru başlamadı."
          }
        }
      }
    },
    "The chess engine stopped unexpectedly.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schachengine wurde unerwartet beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de ajedrez se detuvo de forma inesperada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’échecs s’est arrêté de manière inattendue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore scacchistico si è interrotto inaspettatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de xadrez parou inesperadamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç motoru beklenmedik şekilde durdu."
          }
        }
      }
    },
    "The chess engine's neural network is missing from the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neuronale Netz der Schachengine fehlt in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red neuronal del motor de ajedrez no está incluida en la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau neuronal du moteur d’échecs est absent de l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rete neurale del motore scacchistico non è presente nell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede neural do motor de xadrez não está presente no aplicativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satranç motorunun sinir ağı uygulamada eksik."
          }
        }
      }
    },
    "The complete source code of this version is published, as the license requires, with a tag for each App Store version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vollständige Quellcode dieser Version ist, wie von der Lizenz verlangt, veröffentlicht. Für jede App-Store-Version gibt es ein eigenes Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código fuente completo de esta versión se publica, tal y como exige la licencia, con una etiqueta para cada versión del App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code source complet de cette version est publié, conformément aux exigences de la licence, avec une balise pour chaque version de l’App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice sorgente completo di questa versione è pubblicato, come richiesto dalla licenza, con un tag per ogni versione dell’App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código-fonte completo desta versão está publicado, conforme exige a licença, com uma tag para cada versão da App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisansın gerektirdiği gibi, bu sürümün tüm kaynak kodu yayımlanır. Her App Store sürümü için ayrı bir etiket bulunur."
          }
        }
      }
    },
    "The engine keeps searching the same board after the first move appears, and stops at this time at the latest. It stops earlier once the move has held for several depths, and right away when the device is saving power or has warmed up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine sucht weiter, nachdem der erste Zug angezeigt wird, und stoppt spätestens nach dieser Zeit. Sie beendet die Suche früher, wenn derselbe Zug über mehrere Suchtiefen hinweg der beste bleibt, und sofort, wenn das Gerät Strom spart oder warm geworden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor sigue buscando en el mismo tablero una vez que aparece la primera jugada y se detiene, como muy tarde, en ese momento. Se detiene antes si la jugada se ha mantenido durante varias profundidades, y de inmediato cuando el dispositivo está ahorrando energía o se ha calentado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur continue à analyser le même échiquier après l’apparition du premier coup et s’arrête au plus tard à ce moment-là. Il s’arrête plus tôt dès que le coup a été maintenu sur plusieurs niveaux de profondeur, et immédiatement lorsque l’appareil est en mode économie d’énergie ou chauffe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore continua ad analizzare la stessa posizione dopo aver mostrato la prima mossa e si ferma al più tardi al tempo indicato. Si ferma prima se la mossa resta la migliore per più livelli di profondità, e subito se il dispositivo è in risparmio energetico o si è surriscaldato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo continua pesquisando o mesmo tabuleiro após o primeiro lance aparecer e para, no máximo, nesse momento. Ele para mais cedo assim que o lance se mantiver por várias profundidades e imediatamente quando o dispositivo estiver economizando energia ou tiver aquecido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor, ilk hamle göründükten sonra aynı tahtayı analiz etmeye devam eder ve en geç bu süre dolduğunda durur. Birkaç arama derinliği boyunca aynı hamle en iyi seçenek olarak kalırsa daha erken durur. Aygıt güç tasarrufu yapıyorsa veya ısınmışsa hemen durur."
          }
        }
      }
    },
    "The engine keeps searching the same board after the first move appears.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine sucht in derselben Stellung weiter, nachdem der erste Zug angezeigt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor sigue analizando el tablero tras mostrar la primera jugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur continue d’analyser l’échiquier après l’affichage du premier coup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore continua ad analizzare la stessa posizione dopo aver mostrato la prima mossa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor continua analisando o tabuleiro após mostrar o primeiro lance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motor, ilk hamle göründükten sonra aynı tahtayı aramaya devam eder."
          }
        }
      }
    },
    "The file may be damaged, too small, or in a format this app can't open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist möglicherweise beschädigt, zu klein oder in einem Format, das diese App nicht öffnen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que el archivo esté dañado, sea demasiado pequeño o tenga un formato que esta aplicación no pueda abrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est peut-être endommagé, trop petit ou dans un format que cette application ne peut pas ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file potrebbe essere danneggiato, troppo piccolo o in un formato che l’app non può aprire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo pode estar corrompido, ser muito pequeno ou estar em um formato que este aplicativo não consegue abrir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya hasarlı, çok küçük veya bu uygulamanın açamadığı bir biçimde olabilir."
          }
        }
      }
    },
    "The king or rook is not on its starting square": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "König oder Turm stehen nicht auf ihrem Ausgangsfeld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rey o la torre no están en su casilla inicial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le roi ou la tour ne se trouve pas sur sa case de départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il re o la torre non si trova sulla casa iniziale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rei ou a torre não está na sua casa inicial"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şah veya kale başlangıç karesinde değil"
          }
        }
      }
    },
    "The light and dark squares are the other way round on this board. Some board themes look like that; so does a mirrored screenshot, and then the pieces sit on mirrored squares.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Brett sind die hellen und dunklen Felder vertauscht. Manche Brettdesigns sehen so aus. Es kann sich auch um einen gespiegelten Screenshot handeln; dann stehen die Figuren ebenfalls auf gespiegelten Feldern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este tablero, las casillas claras y oscuras están invertidas. Algunos temas de tablero tienen ese aspecto; lo mismo ocurre con una captura de pantalla reflejada, en la que las piezas se sitúan en casillas reflejadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet échiquier, les cases claires et foncées sont inversées. Certains thèmes d’échiquier présentent cet aspect ; il en va de même pour une capture d’écran en miroir, et les pièces se trouvent alors sur des cases inversées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa scacchiera le case chiare e scure sono invertite. Può dipendere dallo stile della scacchiera o da uno screenshot specchiato; in quest’ultimo caso, anche i pezzi si trovano su case specchiate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As casas claras e escuras estão invertidas neste tabuleiro. Alguns temas de tabuleiro têm essa aparência; o mesmo ocorre com uma captura de tela espelhada, e, nesse caso, as peças ficam em casas espelhadas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tahtada açık ve koyu kareler ters yerlerde. Bazı tahta temaları böyledir. Aynalanmış bir ekran görüntüsü de böyle görünür; o durumda taşlar da aynalanmış karelerdedir."
          }
        }
      }
    },
    "The move on screen switches to a better one by itself, if you ask it to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Wunsch wird der angezeigte Zug automatisch durch einen besseren ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La jugada que aparece en pantalla cambia por sí sola a una mejor, si así se le indica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coup affiché à l’écran se remplace automatiquement par un meilleur coup si vous le demandez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo desideri, la mossa mostrata viene sostituita automaticamente quando ne viene trovata una migliore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A jogada na tela muda automaticamente para uma melhor, se você solicitar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz ekrandaki hamle, daha iyi bir hamle bulunduğunda kendiliğinden değişir."
          }
        }
      }
    },
    "The pawn on %@ can't stand on the back rank.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bauer auf %1$@ darf nicht auf der Grundreihe stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peón en %1$@ no puede estar en la primera ni en la octava fila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pion sur %1$@ ne peut pas se trouver sur la dernière rangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pedone in %1$@ non può trovarsi sull’ultima traversa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peão em %1$@ não pode ficar na primeira nem na oitava fileira."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ karesindeki piyon son yatayda bulunamaz."
          }
        }
      }
    },
    "The payment went through, but the analyses couldn't be added yet. They are added the next time you open the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung war erfolgreich, aber die Analysen konnten noch nicht hinzugefügt werden. Das geschieht beim nächsten Öffnen der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se ha procesado, pero aún no se han podido añadir los análisis. Se añadirán la próxima vez que abras la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement a été effectué, mais les analyses n’ont pas encore pu être ajoutées. Elles seront ajoutées lors de votre prochaine ouverture de l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è riuscito, ma non è stato ancora possibile aggiungere le analisi. Verranno aggiunte alla prossima apertura dell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento foi processado, mas as análises ainda não puderam ser adicionadas. Elas serão adicionadas na próxima vez que você abrir o aplicativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme alındı ancak analizler henüz eklenemedi. Uygulamayı bir sonraki açışınızda eklenir."
          }
        }
      }
    },
    "The person who approves purchases for your Apple Account needs to confirm it. Pro unlocks as soon as it's approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die für Käufe mit deinem Apple Account zuständige Person muss zustimmen. Sobald der Kauf genehmigt ist, wird Pro freigeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona que aprueba las compras de tu cuenta de Apple debe confirmarlo. La versión Pro se desbloquea tan pronto como se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne qui valide les achats sur votre compte Apple doit donner son accord. La version Pro est débloquée dès que l’autorisation est accordée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona che approva gli acquisti per il tuo Apple Account deve confermare l’acquisto. Pro si attiverà non appena sarà approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa responsável por aprovar compras na sua Conta Apple precisa confirmar a transação. O Pro é desbloqueado assim que for aprovado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınızın satın alımlarını onaylayan kişinin bu işleme onay vermesi gerekiyor. Onay verilir verilmez Pro açılır."
          }
        }
      }
    },
    "The person who approves purchases for your Apple Account needs to confirm it. Your board is analyzed as soon as it's approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die für Käufe mit deinem Apple Account zuständige Person muss zustimmen. Sobald der Kauf genehmigt ist, wird deine Stellung analysiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona que aprueba las compras de tu cuenta de Apple debe confirmarlo. Tu tablero se analiza tan pronto como se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne chargée d’approuver les achats sur votre compte Apple doit donner son accord. Votre position est analysée dès qu’elle est approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La persona che approva gli acquisti per il tuo Apple Account deve confermare l’acquisto. La posizione verrà analizzata non appena sarà approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa que aprova as compras na sua Conta Apple precisa confirmar isso. Seu tabuleiro é analisado assim que for aprovado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Hesabınızın satın alımlarını onaylayan kişinin bu işleme onay vermesi gerekiyor. Onay verilir verilmez tahtanız analiz edilir."
          }
        }
      }
    },
    "The purchase didn't go through. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht abgeschlossen werden. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se ha completado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas abouti. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto non è riuscito. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma tamamlanamadı. Lütfen yeniden deneyin."
          }
        }
      }
    },
    "The purchase is waiting for approval. The analysis starts in Chess Best Move when it is approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf wartet auf Genehmigung. Sobald er genehmigt ist, startet die Analyse in Chess Best Move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación. El análisis comienza en Chess Best Move cuando se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat est en attente de validation. L'analyse démarre dans Chess Best Move une fois qu'il est validé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acquisto è in attesa di approvazione. L’analisi inizierà in Chess Best Move appena sarà approvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação. A análise começa no Chess Best Move assim que for aprovada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işlemi onay bekliyor. Onay verildiğinde analiz Chess Best Move’da başlar."
          }
        }
      }
    },
    "The shortcut uses the same free analyses as the app. Board not found never uses one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kurzbefehl nutzt dieselben kostenlosen Analysen wie die App. Wird kein Brett gefunden, wird keine Analyse verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El atajo utiliza los mismos análisis gratuitos que la aplicación. «Tablero no encontrado» nunca utiliza ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le raccourci utilise les mêmes analyses gratuites que l’application. « Échiquier introuvable » n’en utilise jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando rapido usa le stesse analisi gratuite dell’app. Se non viene trovata una scacchiera, non ne consuma nessuna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho usa as mesmas análises gratuitas que o aplicativo. “Tabuleiro não encontrado” nunca usa uma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirme, uygulamayla aynı ücretsiz analiz haklarını kullanır. Tahta bulunamazsa analiz hakkı harcanmaz."
          }
        }
      }
    },
    "The side to move has no legal moves.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe am Zug hat keine legalen Züge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bando que tiene el turno no tiene jugadas legales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le camp qui a le trait n’a aucun coup légal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore che ha il tratto non ha mosse legali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lado que tem a vez não tem lances legais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hamle sırası gelen tarafın yasal hamlesi yok."
          }
        }
      }
    },
    "The think time is not valid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedenkzeit ist ungültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El «tiempo de reflexión» no es válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de réflexion n’est pas valable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di analisi non è valido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O “tempo de reflexão” não é válido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşünme süresi geçerli değil."
          }
        }
      }
    },
    "The whole board must be visible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesamte Brett muss sichtbar sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero debe estar visible en su totalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échiquier doit être entièrement visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scacchiera deve essere interamente visibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o tabuleiro deve estar visível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtanın tamamı görünmeli."
          }
        }
      }
    },
    "Their likely move": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voraussichtlicher gegnerischer Zug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su jugada probable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur coup probable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mossa probabile dell’altro giocatore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lance provável deles"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklenen hamle"
          }
        }
      }
    },
    "Their likely move so far: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher voraussichtlicher gegnerischer Zug: %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugada probable del rival por ahora: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup probable de l’adversaire pour le moment : %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mossa probabile dell’altro giocatore finora: %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance provável do adversário por enquanto: %1$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu ana kadar beklenen hamle: %1$@."
          }
        }
      }
    },
    "Their likely move: %@.": {
      "localizations": {
