        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %1$@ par semaine. Le changement prend effet au prochain renouvellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %1$@ a settimana. Il cambio avviene al prossimo rinnovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %1$@ por semana. A mudança começa na próxima renovação."
