    "History could not be read. The saved file has been kept. Clear History to start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht gelesen werden. Die gespeicherte Datei wurde beibehalten. Lösche den Verlauf, um neu zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el historial. Se ha conservado el archivo guardado. Borra el historial para empezar de nuevo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el historial. Se conservó el archivo guardado. Borra el historial para empezar de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang history. Nananatili ang naka-save na file. Piliin ang Burahin ang History para magsimula ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’historique. Le fichier enregistré a été conservé. Effacez l’historique pour recommencer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास पढ़ा नहीं जा सका। सहेजी हुई फ़ाइल सुरक्षित है। फिर शुरू करने के लिए “इतिहास मिटाएँ” चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la cronologia. Il file salvato è stato conservato. Cancella la cronologia per ricominciare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o histórico. O arquivo salvo foi preservado. Limpe o histórico para começar novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş okunamadı. Kaydedilmiş dosya korundu. Yeniden başlamak için geçmişi temizleyin."
          }
        }
      }
    },
    "History could not be saved. Your current results are still available while the app is open.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht gespeichert werden. Deine aktuellen Ergebnisse bleiben verfügbar, solange die App geöffnet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el historial. Tus resultados actuales siguen disponibles mientras la app está abierta."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el historial. Tus resultados actuales siguen disponibles mientras la app está abierta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na-save ang history. Magagamit pa rin ang kasalukuyang mga resulta habang bukas ang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’historique. Vos résultats actuels restent disponibles tant que l’app est ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास सहेजा नहीं जा सका। ऐप खुला रहने तक मौजूदा नतीजे उपलब्ध हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la cronologia. I risultati attuali restano disponibili finché l’app è aperta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o histórico. Seus resultados atuais continuam disponíveis enquanto o app estiver aberto."
          }
        },
        "tr": {
          "stringUnit": {
