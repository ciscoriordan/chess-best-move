    "Shows the board full screen and plays the move. Tap again to return.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das Schachbrett im Vollbild und animiert den Zug. Tippe erneut, um zurückzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the board full screen and plays the move. Tap again to return."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el tablero a pantalla completa y anima la jugada. Toca de nuevo para volver."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el tablero a pantalla completa y anima la jugada. Toca de nuevo para volver."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinalalaki ang board sa buong screen at ipinapakita ang tira. I-tap ulit para bumalik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’échiquier en plein écran et anime le coup. Touchez à nouveau pour revenir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोर्ड पूरी स्क्रीन पर दिखाकर चाल चलाता है। लौटने के लिए फिर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la scacchiera a schermo intero e anima la mossa. Tocca di nuovo per tornare indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o tabuleiro em tela cheia e anima a jogada. Toque novamente para voltar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtayı tam ekran gösterir ve hamleyi canlandırır. Geri dönmek için tekrar dokunun."
          }
        }
      }
    },
