    "Open Chess Best Move on iPhone and allow full Photos access to read new screenshots.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Chess Best Move on iPhone and allow full Photos access to read new screenshots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Chess Best Move auf dem iPhone und erlaube vollen Fotozugriff, um neue Screenshots zu lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Chess Best Move en el iPhone y permite acceso completo a Fotos para leer nuevas capturas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Chess Best Move sur l’iPhone et autorisez l’accès complet aux photos pour lire les nouvelles captures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Chess Best Move su iPhone e consenti l’accesso completo a Foto per leggere i nuovi screenshot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Chess Best Move no iPhone e permita acesso completo às Fotos para ler novas capturas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da Chess Best Move’u açın ve yeni ekran görüntülerini okumak için Fotoğraflar’a tam erişim verin."
          }
        }
      }
    },
    "Take a new iPhone screenshot, then tap Analyze within 30 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a new iPhone screenshot, then tap Analyze within 30 seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle einen neuen iPhone-Screenshot und tippe innerhalb von 30 Sekunden auf Analysieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una nueva captura en el iPhone y toca Analizar antes de 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une nouvelle capture sur l’iPhone, puis touchez Analyser dans les 30 secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai un nuovo screenshot su iPhone, poi tocca Analizza entro 30 secondi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma nova captura no iPhone e toque em Analisar em até 30 segundos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da yeni ekran görüntüsü alın ve 30 saniye içinde Analiz et’e dokunun."
          }
        }
      }
    },
    "This position needs confirmation. Open the screenshot in Chess Best Move on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This position needs confirmation. Open the screenshot in Chess Best Move on iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Stellung muss bestätigt werden. Öffne den Screenshot in Chess Best Move auf dem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta posición necesita confirmación. Abre la captura en Chess Best Move en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette position doit être confirmée. Ouvrez la capture dans Chess Best Move sur l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa posizione richiede una conferma. Apri lo screenshot in Chess Best Move su iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta posição precisa de confirmação. Abra a captura no Chess Best Move no iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konumun doğrulanması gerekiyor. Ekran görüntüsünü iPhone’da Chess Best Move’da açın."
          }
        }
      }
    },
    "No clear chessboard found. Take a screenshot showing the whole board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clear chessboard found. Take a screenshot showing the whole board."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein deutliches Schachbrett gefunden. Erstelle einen Screenshot des ganzen Bretts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un tablero claro. Haz una captura que muestre el tablero entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun échiquier net trouvé. Prenez une capture de l’échiquier entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna scacchiera chiara trovata. Fai uno screenshot dell’intera scacchiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum tabuleiro nítido encontrado. Faça uma captura do tabuleiro inteiro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net bir satranç tahtası bulunamadı. Tahtanın tamamını gösteren ekran görüntüsü alın."
          }
        }
      }
    },
    "No analyses remaining. Open Chess Best Move on iPhone for Pro or more analyses.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No analyses remaining. Open Chess Best Move on iPhone for Pro or more analyses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Analysen übrig. Öffne Chess Best Move auf dem iPhone für Pro oder weitere Analysen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan análisis. Abre Chess Best Move en el iPhone para obtener Pro o más análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune analyse restante. Ouvrez Chess Best Move sur l’iPhone pour Pro ou plus d’analyses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna analisi rimasta. Apri Chess Best Move su iPhone per Pro o altre analisi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma análise restante. Abra Chess Best Move no iPhone para obter Pro ou mais análises."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiz kalmadı. Pro veya daha fazla analiz için iPhone’da Chess Best Move’u açın."
          }
        }
      }
    },
    "The iPhone app is busy. Leave Chess Best Move on iPhone, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone app is busy. Leave Chess Best Move on iPhone, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iPhone-App ist beschäftigt. Verlasse Chess Best Move auf dem iPhone und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app del iPhone está ocupada. Sal de Chess Best Move en el iPhone e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app iPhone est occupée. Quittez Chess Best Move sur l’iPhone, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app iPhone è occupata. Esci da Chess Best Move su iPhone, poi riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app do iPhone está ocupado. Saia do Chess Best Move no iPhone e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uygulaması meşgul. iPhone’da Chess Best Move’dan çıkıp tekrar deneyin."
          }
        }
      }
    },
    "The iPhone did not finish in time. Open it once, then try again with a new screenshot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone did not finish in time. Open it once, then try again with a new screenshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone wurde nicht rechtzeitig fertig. Öffne die App einmal und versuche es mit einem neuen Screenshot erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone no terminó a tiempo. Abre la app una vez y vuelve a intentarlo con una nueva captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone n’a pas terminé à temps. Ouvrez l’app une fois, puis réessayez avec une nouvelle capture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone non ha finito in tempo. Apri l’app una volta, poi riprova con un nuovo screenshot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone não terminou a tempo. Abra o app uma vez e tente de novo com uma nova captura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone zamanında tamamlayamadı. Uygulamayı bir kez açın, sonra yeni ekran görüntüsüyle tekrar deneyin."
          }
        }
      }
    },
    "Could not reach the iPhone app. Check the connection and open Chess Best Move on iPhone once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the iPhone app. Check the connection and open Chess Best Move on iPhone once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iPhone-App ist nicht erreichbar. Prüfe die Verbindung und öffne Chess Best Move einmal auf dem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con la app del iPhone. Revisa la conexión y abre Chess Best Move una vez en el iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre l’app iPhone. Vérifiez la connexion et ouvrez Chess Best Move une fois sur l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere l’app iPhone. Controlla la connessione e apri Chess Best Move una volta su iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o app do iPhone. Verifique a conexão e abra Chess Best Move uma vez no iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uygulamasına ulaşılamadı. Bağlantıyı kontrol edin ve iPhone’da Chess Best Move’u bir kez açın."
          }
        }
      }
    },
